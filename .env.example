# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Planka Instance Details
PLANKA_URL=https://your-planka-instance.com
PLANKA_EMAIL=your_email@example.com
PLANKA_PASSWORD=your_password
PLANKA_BOARD_ID=your_board_id
PLANKA_LIST_ID=your_list_id  # Optional: if not set, will use the first list in the board 